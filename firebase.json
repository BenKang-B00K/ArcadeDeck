{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/hall-of-fame",
        "destination": "/",
        "type": 301
      },
      { "regex": "^/(?P<lang>ja|ko)/play/(idle-avatar-rpg|trade-tycoon)/?$", "destination": "/:lang/", "type": 301 },
      { "regex": "^/play/(idle-avatar-rpg|trade-tycoon)/?$", "destination": "/", "type": 301 },
      { "regex": "^/(?P<lang>ja|ko)/forum(/.*)?$", "destination": "/:lang/", "type": 301 },
      { "regex": "^/forum(/.*)?$", "destination": "/", "type": 301 },
      { "source": "/de", "destination": "/", "type": 301 },
      { "source": "/de/:rest*", "destination": "/:rest*", "type": 301 },
      { "source": "/fr", "destination": "/", "type": 301 },
      { "source": "/fr/:rest*", "destination": "/:rest*", "type": 301 },
      { "source": "/zh", "destination": "/", "type": 301 },
      { "source": "/zh/:rest*", "destination": "/:rest*", "type": 301 },
      { "source": "/es", "destination": "/", "type": 301 },
      { "source": "/es/:rest*", "destination": "/:rest*", "type": 301 },
      { "source": "/es-la", "destination": "/", "type": 301 },
      { "source": "/es-la/:rest*", "destination": "/:rest*", "type": 301 },
      { "source": "/pt", "destination": "/", "type": 301 },
      { "source": "/pt/:rest*", "destination": "/:rest*", "type": 301 },
      { "source": "/ru", "destination": "/", "type": 301 },
      { "source": "/ru/:rest*", "destination": "/:rest*", "type": 301 },
      { "source": "/vi", "destination": "/", "type": 301 },
      { "source": "/vi/:rest*", "destination": "/:rest*", "type": 301 },
      { "source": "/play/endless-war", "destination": "/play/kingdom-of-ashes-endless-war", "type": 301 },
      { "source": "/ja/play/endless-war", "destination": "/ja/play/kingdom-of-ashes-endless-war", "type": 301 },
      { "source": "/ko/play/endless-war", "destination": "/ko/play/kingdom-of-ashes-endless-war", "type": 301 },
      { "source": "/play/dicefall-chronicles", "destination": "/play/kingdom-of-ashes-dice-war", "type": 301 },
      { "source": "/ja/play/dicefall-chronicles", "destination": "/ja/play/kingdom-of-ashes-dice-war", "type": 301 },
      { "source": "/ko/play/dicefall-chronicles", "destination": "/ko/play/kingdom-of-ashes-dice-war", "type": 301 },
      { "source": "/play/kingdoms-last-stand", "destination": "/play/kingdom-of-ashes-colosseum", "type": 301 },
      { "source": "/ja/play/kingdoms-last-stand", "destination": "/ja/play/kingdom-of-ashes-colosseum", "type": 301 },
      { "source": "/ko/play/kingdoms-last-stand", "destination": "/ko/play/kingdom-of-ashes-colosseum", "type": 301 }
    ],
    "rewrites": [
      { "source": "/{ja,ko}/{about,privacy,contact,my-games,fractured-realm,blog}", "destination": "/index.html" },
      { "source": "/{ja,ko}/blog/**", "destination": "/index.html" }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://fundingchoicesmessages.google.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebase.com https://fundingchoicesmessages.google.com https://www.google-analytics.com https://*.google-analytics.com https://*.googletagmanager.com https://analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.adtrafficquality.google; frame-src 'self' https:; child-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/images/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/play/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/{about,privacy,contact,my-games,blog}",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/blog/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.webmanifest",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
