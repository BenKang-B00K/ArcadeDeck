rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Leaderboards collection
    match /leaderboards/{document} {
      // Anyone can read the leaderboards
      allow read: if true;

      // Create: validate all required fields and types
      allow create: if request.resource.data.keys().hasAll(['gameId', 'name', 'score', 'createdAt'])
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && (
          !request.resource.data.keys().hasAny(['subScore'])
          || (request.resource.data.subScore is number && request.resource.data.subScore >= 0)
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.gameId is string;

      // Update: name and gameId must not change, score/subScore must be valid
      allow update: if resource.data.name == request.resource.data.name
        && resource.data.gameId == request.resource.data.gameId
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && (
          !request.resource.data.keys().hasAny(['subScore'])
          || (request.resource.data.subScore is number && request.resource.data.subScore >= 0)
        );
    }

    // Comments collection
    match /comments/{document} {
      // Anyone can read comments
      allow read: if true;

      // Create: validate required fields, text/nickname length
      allow create: if request.resource.data.keys().hasAll(['gameId', 'nickname', 'text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 30
        && request.resource.data.gameId is string;

      // Delete/Update not allowed
      allow update, delete: if false;
    }

    // Forum threads — top-level posts in the player forum.
    match /forum_threads/{document} {
      allow read: if true;

      // Create: title <=120, body <=5000, category in allowlist,
      // nickname <=30, replyCount=0, lastActivity=createdAt.
      allow create: if request.resource.data.keys().hasAll(['title', 'body', 'category', 'nickname', 'replyCount', 'createdAt', 'lastActivity'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        && request.resource.data.category is string
        && request.resource.data.category in ['general', 'games', 'suggestions', 'off-topic']
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 30
        && request.resource.data.replyCount == 0;

      // Update: only replyCount + lastActivity may change. Original
      // fields are immutable. replyCount is monotonically non-decreasing
      // and bumps by 1 at a time.
      allow update: if resource.data.title == request.resource.data.title
        && resource.data.body == request.resource.data.body
        && resource.data.category == request.resource.data.category
        && resource.data.nickname == request.resource.data.nickname
        && resource.data.createdAt == request.resource.data.createdAt
        && request.resource.data.replyCount is int
        && request.resource.data.replyCount == resource.data.replyCount + 1;

      allow delete: if false;
    }

    // Forum posts — replies attached to a thread.
    match /forum_posts/{document} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(['threadId', 'nickname', 'body', 'createdAt'])
        && request.resource.data.threadId is string
        && request.resource.data.threadId.size() > 0
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 30
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000;

      allow update, delete: if false;
    }

    // Denormalized podium aggregate (server-maintained via Cloud Function)
    match /aggregates/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Per-game leaderboard top-3 cache (server-maintained via Cloud Function)
    match /leaderboardCache/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
