rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Comments collection
    match /comments/{document} {
      // Anyone can read comments
      allow read: if true;

      // Create: validate required fields, text/nickname length
      allow create: if request.resource.data.keys().hasAll(['gameId', 'nickname', 'text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 30
        && request.resource.data.gameId is string;

      // Delete/Update not allowed
      allow update, delete: if false;
    }

    // Forum removed 2026-09-27: forum_threads / forum_posts fall to default deny.

    // Leaderboard — one row per browser (random UUID id), ranked by Deck XP.
    // No auth, so ownership cannot be enforced; only the shape is validated.
    match /leaderboard/{playerId} {
      allow read: if true;

      allow create, update: if playerId.size() <= 40
        && request.resource.data.keys().hasOnly(['nickname', 'xp', 'level', 'played', 'mastered', 'updatedAt'])
        && request.resource.data.keys().hasAll(['nickname', 'xp', 'level', 'played', 'mastered', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 30
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 1000000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 10001
        && request.resource.data.played is int
        && request.resource.data.played >= 0
        && request.resource.data.played <= 500
        && request.resource.data.mastered is int
        && request.resource.data.mastered >= 0
        && request.resource.data.mastered <= 500
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
