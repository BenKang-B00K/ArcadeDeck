rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Comments collection
    match /comments/{document} {
      // Anyone can read comments
      allow read: if true;

      // Create: validate required fields, text/nickname length
      allow create: if request.resource.data.keys().hasAll(['gameId', 'nickname', 'text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 30
        && request.resource.data.gameId is string;

      // Delete/Update not allowed
      allow update, delete: if false;
    }

    // Forum removed 2026-09-27: forum_threads / forum_posts fall to default deny.

    // Leaderboard — one row per browser (random UUID id), ranked by Deck XP.
    // No auth, so ownership cannot be enforced; only the shape is validated.
    match /leaderboard/{playerId} {
      allow read: if true;

      allow create, update: if playerId.size() <= 40
        && request.resource.data.keys().hasOnly(['nickname', 'xp', 'level', 'played', 'mastered', 'updatedAt'])
        && request.resource.data.keys().hasAll(['nickname', 'xp', 'level', 'played', 'mastered', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 30
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 1000000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 10001
        && request.resource.data.played is int
        && request.resource.data.played >= 0
        && request.resource.data.played <= 500
        && request.resource.data.mastered is int
        && request.resource.data.mastered >= 0
        && request.resource.data.mastered <= 500
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // Two-phone link signaling (Tank Battle): host creates {offer, expireAt},
    // guest writes `answer` once. Codes are 4 chars. No TTL (needs billing):
    // the host deletes its room once linked, and recycles a code whose old
    // room is answered or expired.
    match /coop/{code} {
      allow get: if true;

      allow create: if code.size() == 4
        && request.resource.data.keys().hasOnly(['offer', 'expireAt'])
        && request.resource.data.offer is string
        && request.resource.data.offer.size() < 20000
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt < request.time + duration.value(2, 'h');

      allow update: if !('answer' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
        && request.resource.data.answer is string
        && request.resource.data.answer.size() < 20000;

      allow delete: if 'answer' in resource.data || resource.data.expireAt < request.time;
      allow list: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
