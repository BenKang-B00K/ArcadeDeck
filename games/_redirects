# Kingdom of Ashes ships absolute /sound and /fonts URLs (sfx.ts fetches, base.css @font-face).
# Its build sits under /kingdom-of-ashes-fallen-era/, so rewrite those two roots into it rather
# than patching ~100 paths in the game source. 200 = rewrite, not redirect: the URL stays put.
/sound/*  /kingdom-of-ashes-fallen-era/sound/:splat  200
/fonts/*  /kingdom-of-ashes-fallen-era/fonts/:splat  200

# Shadow Runner does the same with the icon paths baked into its data JSON (equip/upgrade/shop/
# meta/subweapon icons, chapter cutscenes, the scene backdrops, one tag sprite, badge icons). Its index.html
# and CSS came out of Vite fully relative; only the JSON string literals stayed root-absolute.
# These nine roots are now Shadow Runner's on this project — a future game that hardcodes one of
# them needs its own prefix, not a second rule here.
/equip/*      /shadow-runner/equip/:splat      200
/upgrade/*    /shadow-runner/upgrade/:splat    200
/shop/*       /shadow-runner/shop/:splat       200
/meta/*       /shadow-runner/meta/:splat       200
/chapters/*   /shadow-runner/chapters/:splat   200
/subweapon/*  /shadow-runner/subweapon/:splat  200
/scene/*      /shadow-runner/scene/:splat      200
/tag/*        /shadow-runner/tag/:splat        200
/badge/*      /shadow-runner/badge/:splat      200
