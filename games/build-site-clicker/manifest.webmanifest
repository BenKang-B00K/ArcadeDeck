{
  "name": "Build Site Clicker",
  "short_name": "Build Site",
  "description": "Tap to send construction workers and build landmarks, one hammer hit at a time.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
