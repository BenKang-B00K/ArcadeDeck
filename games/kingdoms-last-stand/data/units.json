  "magnetic_mage": {"name": "자기장 마법사", "svg": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>", "img": "unit_image/magnetic_mage.webp", "hp": 110, "atk": 24, "def": 14, "spd": 1.0, "cost": 4, "range": 2, "skillKey": "magnetic_storm", "element": "lightning", "lore": "적들을 한곳으로 모아 아군의 광역 기술 효율을 극대화하는 마법사."},
  "storm_dancer": {"name": "폭풍 무희", "svg": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>", "img": "unit_image/storm_dancer.webp", "hp": 125, "atk": 22, "def": 14, "spd": 1.3, "cost": 5, "range": 2, "skillKey": "thunder_dance", "element": "lightning", "lore": "번개를 타고 춤추는 그녀의 발걸음은 전장에 감전을 남긴다."},
