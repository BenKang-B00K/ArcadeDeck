  "blizzard_sniper": {"name": "블리자드 스나이퍼", "svg": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>", "img": "unit_image/blizzard_sniper.webp", "hp": 80, "atk": 26, "def": 5, "spd": 1.2, "cost": 3, "range": 3, "skillKey": "ice_spike", "element": "frost", "lore": "만년설의 사수. 그의 화살은 적을 얼려붙게 만든다."},
