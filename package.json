{
  "name": "arcadedeck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-games.js",
    "build": "node scripts/validate-games.js && node scripts/generate-sitemap.js && node scripts/generate-rss.js && tsc -b && vite build && node scripts/prerender-pages.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "firebase deploy --only hosting",
    "deploy:games": "wrangler pages deploy games --project-name arcadedeck-games --branch main --commit-dirty=true",
    "indexnow": "node scripts/ping-indexnow.js",
    "indexnow:posts": "node scripts/ping-indexnow.js --posts-only",
    "indexnow:all": "node scripts/ping-indexnow.js --all"
  },
  "dependencies": {
    "firebase": "^12.10.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "wrangler": "^4.130.0"
  }
}
